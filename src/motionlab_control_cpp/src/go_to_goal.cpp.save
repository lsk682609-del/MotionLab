#include <algorithm>
#include <chrono>
#include <cmath>
#include <functional>
#include <memory>

#include "geometry_msgs/msg/twist.hpp"
#include "rclcpp/rclcpp.hpp"
#include "turtlesim/msg/pose.hpp"

using namespace std::chrono_literals;

class GoToGoalCpp : public rclcpp::Node
{
public:
  GoToGoalCpp()
  : Node("go_to_goal_cpp")
  {
    goal_x_ = declare_parameter<double>("goal_x", 8.0);
    goal_y_ = declare_parameter<double>("goal_y", 8.0);
    k_linear_ = declare_parameter<double>("k_linear", 1.0);
    k_angular_ = declare_parameter<double>("k_angular", 4.0);
    max_linear_speed_ =
      declare_parameter<double>("max_linear_speed", 2.0);
    max_angular_speed_ =
      declare_parameter<double>("max_angular_speed", 4.0);
    goal_tolerance_ =
      declare_parameter<double>("goal_tolerance", 0.1);

    publisher_ = create_publisher<geometry_msgs::msg::Twist>(
      "/turtle1/cmd_vel",
      10);

    subscription_ = create_subscription<turtlesim::msg::Pose>(
      "/turtle1/pose",
      10,
      std::bind(
        &GoToGoalCpp::pose_callback,
        this,
        std::placeholders::_1));

    timer_ = create_wall_timer(
      50ms,
      std::bind(&GoToGoalCpp::control_loop, this));

    RCLCPP_INFO(
      get_logger(),
      "Goal set to (%.2f, %.2f)",
      goal_x_,
      goal_y_);
  }

private:
  void pose_callback(
    const turtlesim::msg::Pose::SharedPtr message)
  {
    pose_ = *message;
    pose_received_ = true;
  }

  static double normalize_angle(double angle)
  {
    return std::atan2(std::sin(angle), std::cos(angle));
  }

  static double limit(double value, double maximum)
  {
    return std::max(-maximum, std::min(maximum, value));
  }

  void publish_stop()
  {
    geometry_msgs::msg::Twist command;
    publisher_->publish(command);
  }

  void control_loop()
  {
    if (!pose_received_) {      return;
    }

    const double dx = goal_x_ - pose_.x;
    const double dy = goal_y_ - pose_.y;
    const double distance_error = std::hypot(dx, dy);

    if (distance_error < goal_tolerance_) {
      publish_stop();

      if (!goal_reached_) {
        RCLCPP_INFO(
          get_logger(),
          "Goal reached: distance=%.3f",
          distance_error);
        goal_reached_ = true;
      }

      return;
    }

    goal_reached_ = false;

    const double desired_heading = std::atan2(dy, dx);
    const double heading_error = normalize_angle(
      desired_heading - pose_.theta);

    const double angular_speed = limit(
      k_angular_ * heading_error,
      max_angular_speed_);

    double linear_speed = 0.0;

    if (std::abs(heading_error) <= 0.5) {
      linear_speed = std::min(
        k_linear_ * distance_error,
        max_linear_speed_);
    }

    geometry_msgs::msg::Twist command;
    command.linear.x = linear_speed;
    command.angular.z = angular_speed;
    publisher_->publish(command);

    control_count_++;

    if (control_count_ % 20 == 0) {
      RCLCPP_INFO(
        get_logger(),
        "distance=%.2f, heading_error=%.2f, "
        "v=%.2f, omega=%.2f",
        distance_error,
        heading_error,
        linear_speed,
        angular_speed);
    }
  }

  rclcpp::Publisher<geometry_msgs::msg::Twist>::SharedPtr
    publisher_;

  rclcpp::Subscription<turtlesim::msg::Pose>::SharedPtr
    subscription_;

  rclcpp::TimerBase::SharedPtr timer_;

  turtlesim::msg::Pose pose_;

  bool pose_received_{false};
  bool goal_reached_{false};
  std::size_t control_count_{0};

  double goal_x_;
  double goal_y_;
  double k_linear_;
  double k_angular_;
  double max_linear_speed_;
  double max_angular_speed_;
  double goal_tolerance_;
};


int main(int argc, char * argv[])
{
  rclcpp::init(argc, argv);

  auto node = std::make_shared<GoToGoalCpp>();
  rclcpp::spin(node);

  rclcpp::shutdown();
  return 0;
}
